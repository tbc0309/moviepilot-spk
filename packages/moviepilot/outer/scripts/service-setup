### Generic variables and functions
### -------------------------------

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
  echo "Error: Environment variables are not set." 1>&2;
  echo "Please run me using synopkg instead. Example: \"synopkg start [packagename]\"" 1>&2;
  exit 1
fi

PACKAGE_BASE="/var/packages/${SYNOPKG_PKGNAME}/target"
USER="MoviePilot"
EFF_USER="sc-MoviePilot"
SVC_CWD="${PACKAGE_BASE}"
export PATH="$PATH:${PACKAGE_BASE}/bin:/var/packages/Node.js_v22/target/usr/local/bin"
export UV_BIN="${PACKAGE_BASE}/bin/uv"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:${PACKAGE_BASE}/lib"
export PYTHONPATH="${PACKAGE_BASE}/moviepilot"
export FRONTEND_PATH="${PACKAGE_BASE}/public"
export CONFIG_DIR="${PACKAGE_BASE}/config"
export TMP="${PACKAGE_BASE}/tmp"
export NGINX_PORT="13000"
export PORT="13001"
export MOVIEPILOT_AUTO_UPDATE="false"
export HOST="127.0.0.1"

# start-stop-status script redirect stdout/stderr to LOG_FILE
LOG_FILE="${PACKAGE_BASE}/logs/${SYNOPKG_PKGNAME}.log"

# Service command has to deliver its pid into PID_FILE
PID_FILE="${SYNOPKG_PKGVAR}/${SYNOPKG_PKGNAME}.pid"

### Package specific variables and functions
### ----------------------------------------

SERVICE_COMMAND="${PACKAGE_BASE}/bin/supervisord -n -c ${PACKAGE_BASE}/supervisord.conf"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

link_config_folder() {
    persistent_config="${SYNOPKG_PKGVAR}/config"
    package_config="${PACKAGE_BASE}/config"

    # Keep user configuration under @appdata and expose the historical target/config path.
    # Package defaults are copied only when the corresponding persistent file is absent.
    if [ -L "${persistent_config}" ]; then
        echo "Refusing symbolic link at ${persistent_config}" 1>&2
        return 1
    fi
    $MKDIR "${persistent_config}"
    if [ -d "${package_config}" ] && [ ! -L "${package_config}" ]; then
        $RSYNC --ignore-existing "${package_config}/" "${persistent_config}/"
    fi
    $RM "${package_config}"
    $LN "${persistent_config}" "${package_config}"
}

service_postinst() {
    link_config_folder
}

service_preupgrade() {
    link_config_folder || return 1
    backup="${SYNOPKG_PKGVAR}/plugin-upgrade-backup"
    $RM "${backup}"
    if [ -d "${PACKAGE_BASE}/moviepilot/app/plugins" ]; then
        mkdir -p "${backup}"
        cp -a "${PACKAGE_BASE}/moviepilot/app/plugins/." "${backup}/"
    fi
}

service_postupgrade() {
    backup="${SYNOPKG_PKGVAR}/plugin-upgrade-backup"
    plugins="${PACKAGE_BASE}/moviepilot/app/plugins"
    old_manifest="${backup}/.spk-bundled-plugins"
    new_manifest="${plugins}/.spk-bundled-plugins"

    link_config_folder || return 1

    # The new package keeps a clean copy of all bundled V3 plugins. Restore only
    # user-installed plugin directories so old bundled files cannot mix with new ones.
    if [ -d "${backup}" ]; then
        for plugin in "${backup}"/*; do
            [ -d "${plugin}" ] || continue
            plugin_name=$(basename "${plugin}")
            if { [ -f "${old_manifest}" ] && grep -Fxq "${plugin_name}" "${old_manifest}"; } || \
               { [ -f "${new_manifest}" ] && grep -Fxq "${plugin_name}" "${new_manifest}"; }; then
                continue
            fi
            cp -a "${plugin}" "${plugins}/"
        done
        $RM "${backup}"
    fi
}
